APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
PUBLIC_CATALOGUE_BRANCH_SLUG=tms-rusape-main
RESERVATION_EXPIRATION_MINUTES=15
PAYNOW_ENABLED=false
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_CURRENCY=USD
PAYNOW_CONNECT_TIMEOUT_SECONDS=3
PAYNOW_TIMEOUT_SECONDS=8
PAYNOW_POLL_RETRIES=2

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Required before seeding production; local development uses a development-only fallback (admin123).
SEED_ADMIN_EMAIL=admin@tms.com
SEED_ADMIN_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
OBSERVABILITY_LOG_CHANNEL=observability
OBSERVABILITY_LOG_LEVEL=info
OBSERVABILITY_LOG_MAX_FILES=14
# Set FAILED_JOB_LOG_CHANNEL=slack and LOG_SLACK_WEBHOOK_URL to page on failed jobs.
# LOG_SLACK_WEBHOOK_URL=
FAILED_JOB_LOG_CHANNEL=observability

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production so session cookies are only sent over HTTPS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# POS discount approval threshold (percent)
POS_MAX_DISCOUNT_PERCENT_WITHOUT_APPROVAL=10
